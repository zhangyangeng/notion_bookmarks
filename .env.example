# ============================================
# Notion 导航站 - 环境变量示例
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# ⚠️ .env 已被 .gitignore 忽略，请勿提交任何真实密钥
# ============================================

# ---- Notion 配置（必填）----
# Notion 集成令牌，在 https://www.notion.so/my-integrations 创建
NOTION_TOKEN=

# 链接库 ID（收藏的网站条目）
NOTION_LINKS_DB_ID=

# 分类库 ID
NOTION_CATEGORIES_DB_ID=

# 合集库 ID（分享页 /c/[slug] 的数据源）
NOTION_COLLECTIONS_DB_ID=

# 网站配置页 ID（站点标题、社交链接等）
NOTION_WEBSITE_CONFIG_ID=

# ---- 部署 ----
# 站点公开访问地址，用于生成绝对链接（og:url、分享链接等）。
# 必须与访客实际访问的域名一致，例如 https://nav.wrysmile.cn。
# 未配置时构建期退回 Vercel 提供的部署域名，本地退回 localhost。
NEXT_PUBLIC_SITE_URL=

# Vercel Deploy Hook 地址，供外部触发部署使用，站点代码不读取
DEPLOY_URL=

# ---- 分析与统计（可选，不填则不启用）----
# 微软 Clarity 站点 ID
NEXT_PUBLIC_CLARITY_ID=

# Google Analytics 测量 ID
GA_ID=
